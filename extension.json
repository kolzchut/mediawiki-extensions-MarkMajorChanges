{
	"name": "MarkMajorChanges",
	"version": "0.8.0",
	"author": [
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://github.com/kolzchut/mediawiki-extensions-MarkMajorChanges",
	"descriptionmsg": "markmajorchanges-desc",
	"license-name": "GPL-2.0-or-late",
	"type": "other",
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\MarkMajorChanges\\": "includes/"
	},
	"SpecialPages": {
		"MajorChangesLog": {
			"class": "MediaWiki\\Extension\\MarkMajorChanges\\SpecialMajorChangesLog",
			"services": [
				"ConnectionProvider"
			]
		}
	},
	"APIListModules": {
		"majorchangeslogevents": {
			"class": "MediaWiki\\Extension\\MarkMajorChanges\\ApiQueryMajorChangesLogEvents",
			"services": [
				"CommentStore",
				"RowCommentFormatter",
				"ChangeTagDefStore",
				"UserNameUtils",
				"LogFormatterFactory",
				"TitleFactory"
			]
		}
	},
	"config": {
		"MarkMajorChangesJiraConf": {
			"value": {
				"username": null,
				"password": null,
				"url": null,
				"project": null,
				"shortlinkFormat": null
			}
		},
		"MarkMajorChangesLanguages": {
			"value": ["ar", "ru"]
		},
		"MarkMajorChangesLangLinksExemptNamespaces": {
			"value": []
		}
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\MarkMajorChanges\\Hooks",
			"services": [
				"PermissionManager"
			]
		}
	},
	"Hooks": {
		"SkinTemplateNavigation::Universal": "main",
		"ListDefinedTags": "main",
		"ChangeTagsListActive": "main"
	},
	"AvailableRights": [
		"markmajorchange",
		"majorchanges-log"
	],
	"GroupPermissions": {
		"staff": {
			"markmajorchange": true
		},
		"*": {
			"majorchanges-log": true
		}
	},
	"Actions": {
		"markmajorchange": {
			"class": "MediaWiki\\Extension\\MarkMajorChanges\\MajorChangeAction",
			"services": [
				"MainConfig",
				"ContentLanguage",
				"LanguageNameUtils",
				"PermissionManager",
				"HttpRequestFactory",
				"ConnectionProvider",
				"RevisionLookup"
			]
		}
	},
	"ResourceModules": {
		"mediawiki.action.majorchange": {
			"scripts": "mediawiki.action.majorchange.js",
			"targets": [
				"desktop",
				"mobile"
			],
			"position": "bottom"
		},
		"mediawiki.special.majorchanges": {
			"styles": "mediawiki.special.majorchanges.less",
			"scripts": "mediawiki.special.majorchanges.js",
			"targets": [
				"desktop",
				"mobile"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "WikiRights/MarkMajorChanges/resources"
	},
	"MessagesDirs": {
		"MarkMajorChanges": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"MajorChangesLogAlias": "MajorChangesLog.alias.php"
	},
	"manifest_version": 2
}
